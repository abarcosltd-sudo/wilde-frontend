rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    /**
     * Admin role, for the staff panel at /admin.
     *
     * The role comes from a signed custom claim, set server-side with the Admin
     * SDK (`setCustomUserClaims(uid, { role: 'admin' })`). The `role` field on
     * the Users document is deliberately *not* consulted here: a user may write
     * their own Users document, so trusting it would let anyone promote
     * themselves to superadmin. The client falls back to that field to decide
     * what to render, which is why these rules — not the panel — are the
     * boundary that matters.
     *
     * `.get('role', '')` rather than `.role` because reading a claim that isn't
     * present raises an evaluation error and denies the request outright.
     */
    function role()        { return isAuth() ? request.auth.token.get('role', '') : ''; }
    function isStaff()     { return role() in ['superadmin', 'admin', 'moderator', 'analyst']; }
    function canModerate() { return role() in ['superadmin', 'admin', 'moderator']; }
    function isSuperadmin(){ return role() == 'superadmin'; }

    /**
     * Allows an update that does nothing but move one numeric counter by
     * exactly one. Used for the social counters that a *non-owner* has to be
     * able to change: following someone bumps their followersCount, liking a
     * post bumps its likeCount, joining a group bumps its memberCount.
     *
     * Without this, those writes are denied — the owning user is the only one
     * allowed to touch their own document, but they are not the one acting.
     * Restricting the diff to a single key and a step of one keeps that narrow:
     * a caller cannot ride along with other field changes or set the value
     * arbitrarily. It does not stop someone repeating the call to inflate a
     * count; that needs server-side aggregation to fix properly.
     */
    function isCounterStep(field) {
      return isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field, 'updatedAt'])
        && (request.resource.data[field] == resource.data[field] + 1
         || request.resource.data[field] == resource.data[field] - 1);
    }

    function work(workId) {
      return get(/databases/$(database)/documents/Works/$(workId)).data;
    }

    /**
     * The author, or anyone they invited as a collaborator. Costs one document
     * read per evaluation, so it is only used where collaboration is the point.
     */
    function canEditWorkContent(workId) {
      let w = work(workId);
      // `collaborators` is optional — works are created without it — and reading
      // a key that isn't there raises an evaluation error, so it is guarded.
      return isAuth() && (
        request.auth.uid == w.authorId || (
          'collaborators' in w &&
          w.collaborators is list &&
          request.auth.uid in w.collaborators
        )
      );
    }

    match /Users/{uid} {
      allow read: if true;
      allow create, delete: if isOwner(uid);
      // followersCount is stepped by whoever follows or unfollows them.
      allow update: if isOwner(uid) || isCounterStep('followersCount');
      /**
       * Staff may suspend or annotate an account from /admin/users. `role` is
       * excluded because it lives in the custom claim — a client write to that
       * field grants nothing, and allowing it would only make the document
       * disagree with the token. `email` and `uid` are excluded because they
       * identify the account.
       */
      allow update: if canModerate()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'email', 'uid']);
    }

    match /Works/{workId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.authorId;
      allow delete: if isAuth() && request.auth.uid == resource.data.authorId;
      /**
       * Editing is author-only — collaborators may change the text (see
       * /Chapters) but not retitle, reprice, publish or delete.
       *
       * likeCount and viewCount are the exceptions: they are stepped by the
       * reader, who is by definition not the author.
       */
      allow update: if (isAuth() && request.auth.uid == resource.data.authorId)
                    || isCounterStep('likeCount')
                    || isCounterStep('viewCount');
      // Moderation: unpublish or remove a work that breaks the rules.
      allow update, delete: if canModerate();
    }

    match /Likes/{likeId} {
      allow read: if isAuth();
      /**
       * The id is `{workId}_{userId}`, so requiring it to match the caller makes
       * a like idempotent and un-forgeable: nobody can like on someone else's
       * behalf, and liking twice writes the same document.
       */
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.userId
        && likeId == request.resource.data.workId + '_' + request.auth.uid;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    match /HireRequests/{requestId} {
      // Visible to the two people involved.
      allow read: if isAuth() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.fromUserId;
    }

    match /Chapters/{chapterId} {
      allow read: if true;
      // Previously `if isAuth()`, which let any signed-in user rewrite or delete
      // any chapter of anyone's work.
      allow create: if isAuth() && canEditWorkContent(request.resource.data.workId);
      allow update, delete: if isAuth() && canEditWorkContent(resource.data.workId);
      allow update, delete: if canModerate();
    }

    match /Follows/{followId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isAuth() && request.auth.uid == resource.data.followerId;
      allow delete: if canModerate();
    }

    match /Posts/{postId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.authorId;
      allow delete: if isAuth() && request.auth.uid == resource.data.authorId;
      // Anyone signed in may like or comment; only the author may edit the post.
      allow update: if (isAuth() && request.auth.uid == resource.data.authorId)
                    || isCounterStep('likeCount')
                    || isCounterStep('commentCount');
      allow update, delete: if canModerate();
    }

    match /Comments/{commentId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.authorId;
      allow delete: if isAuth() && request.auth.uid == resource.data.authorId;
      allow update, delete: if canModerate();
    }

    match /Groups/{groupId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.createdBy;
      // memberCount is stepped by whoever joins or leaves.
      allow update: if (isAuth() && request.auth.uid == resource.data.createdBy)
                    || isCounterStep('memberCount');
      allow delete: if isAuth() && request.auth.uid == resource.data.createdBy;
      allow update, delete: if canModerate();
    }

    match /GroupMembers/{memberId} {
      allow read: if isAuth();
      // Previously `if isAuth()`, which let anyone remove anyone else from a group.
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.userId;
      allow update, delete: if canModerate();
    }

    match /GhostwriterListings/{listingId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.userId;
      // Approve, reject or pause a listing from /admin/market.
      allow update, delete: if canModerate();
    }

    match /Orders/{orderId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      );
      /**
       * Created server-side only, by `POST /api/payments/initiate`, and moved to
       * `completed` only by verified provider confirmation (the Admin SDK
       * bypasses these rules).
       *
       * Client create is withheld deliberately: an Order unlocks paywalled
       * content and qualifies its buyer to leave a review, so allowing the
       * client to write one — as this rule previously did — let any user forge a
       * completed order and read any paid work for free.
       */
      // Dispute resolution needs to see every order, not just one side's.
      allow read: if isStaff();
      allow update: if canModerate();
    }

    match /Prompts/{promptId} {
      /**
       * Created server-side only, off a real model call (`POST /api/ai/generate`
       * writes the record; the Admin SDK bypasses these rules). Client create is
       * therefore withheld — otherwise anyone could forge history entries the AI
       * never produced.
       *
       * Read stays open to the owner for a direct single-document fetch, but the
       * app lists history via `GET /api/ai/prompts`: a client list query cannot
       * prove the `userId` match this rule requires.
       */
      allow read, delete: if isAuth() && request.auth.uid == resource.data.userId;
      allow read: if isStaff();
      allow update, delete: if canModerate();
    }

    match /Streaks/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isStaff();
    }

    match /Reminders/{reminderId} {
      allow read, update, delete: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow read: if isStaff();
    }

    match /Notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      /**
       * Necessarily open: notifications are written *to* someone else — a new
       * follower, a buyer, a publishing author fanning out to followers — so the
       * recipient can never be the caller. The shape check keeps it to
       * well-formed, unread notifications rather than arbitrary documents.
       * Moving this fan-out server-side is the real fix.
       */
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(['userId', 'icon', 'message', 'read'])
        && request.resource.data.read == false;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.userId;
      allow read: if isStaff();
    }

    match /Jobs/{jobId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == request.resource.data.posterId;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.posterId;
      allow update, delete: if canModerate();
    }

    match /JobApplications/{applicationId} {
      // Readable so a poster can see applicants and an applicant can see that
      // they already applied.
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.applicantId;
      allow delete: if isAuth() && request.auth.uid == resource.data.applicantId;
    }

    match /Payments/{paymentId} {
      // Read-only to the client; payment documents are written server-side.
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      /**
       * The ledger is readable by staff and writable by nobody. Refunds move
       * real money and belong to the provider integration in the backend, which
       * uses the Admin SDK and bypasses these rules entirely.
       */
      allow read: if isStaff();
    }

    match /Reviews/{reviewId} {
      allow read: if true;
      /**
       * Buyer eligibility is enforced in the client (`useReviews` only shows the
       * form to someone holding a completed Order). Re-checking it here would
       * need a query, which rules cannot do — it would take a denormalised
       * `Orders/{buyerId}_{sellerId}` document to `get()`. Left as-is,
       * consistent with the Orders note above.
       */
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.reviewerId;
      allow update, delete: if canModerate();
    }

    /**
     * Every write made from /admin is recorded here first, by `adminData`.
     *
     * Append-only, including for superadmins: `update` and `delete` are denied
     * outright rather than gated on a role. An audit trail that the people being
     * audited can rewrite records nothing. Pinning `actorUid` to the caller
     * means an entry cannot be attributed to someone else.
     */
    match /AdminAudit/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Reserved for platform-wide settings edited from the admin panel.
    match /AdminSettings/{docId} {
      allow read: if isStaff();
      allow write: if isSuperadmin();
    }
  }
}
